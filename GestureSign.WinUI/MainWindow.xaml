<Window
    x:Class="GestureSign.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="GestureSign V2">

    <Grid x:Name="Root">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainContentScrollViewer.Padding" Value="12,4,12,20" />
                        <Setter Target="AppTitleBar.Padding" Value="12,0,12,0" />
                        <Setter Target="PageTitle.FontSize" Value="20" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainContentScrollViewer.Padding" Value="20,8,24,28" />
                        <Setter Target="AppTitleBar.Padding" Value="16,0,16,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainContentScrollViewer.Padding" Value="28,8,32,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Height="48"
              Padding="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/logo.png"
                   Width="28"
                   Height="28"
                   VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="GestureSign V2"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <controls:NavigationView x:Name="Navigation"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 PaneDisplayMode="Auto"
                                 CompactModeThresholdWidth="720"
                                 ExpandedModeThresholdWidth="1000"
                                 IsBackButtonVisible="Collapsed"
                                 IsSettingsVisible="False"
                                 IsPaneToggleButtonVisible="True"
                                 IsPaneOpen="True"
                                 OpenPaneLength="248"
                                 CompactPaneLength="60"
                                 SelectionChanged="Navigation_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="动作" Tag="actions" Icon="Play" />
                <controls:NavigationViewItem Content="忽略" Tag="ignored" Icon="BlockContact" />
                <controls:NavigationViewItem Content="手势" Tag="gestures" Icon="TouchPointer" />
                <controls:NavigationViewItem Content="快捷操作" Tag="quickActions" Icon="Keyboard" />
                <controls:NavigationViewItem Content="触控板边缘" Tag="touchpad">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE815;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="选项" Tag="options" Icon="Setting" />
                <controls:NavigationViewItem Content="关于" Tag="about" Icon="Help" />
            </controls:NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="RecognitionDisabledBanner"
                        Visibility="Collapsed"
                        Margin="20,10,24,4"
                        Padding="14,10"
                        CornerRadius="6"
                        Background="#22FFB900"
                        BorderBrush="#66FFB900"
                        BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BA;"
                                  FontSize="18"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="RecognitionDisabledText"
                                   Grid.Column="1"
                                   Text="手势识别已关闭"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button x:Name="RecognitionDisabledEnableButton"
                                Grid.Column="2"
                                Content="启用手势识别"
                                Click="RecognitionDisabledEnableButton_Click" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="MainContentScrollViewer"
                              Grid.Row="1"
                              Padding="28,8,32,32"
                              Background="Transparent">
                    <StackPanel Spacing="18">
                        <TextBlock x:Name="PageTitle"
                                   Text="动作"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   IsTextSelectionEnabled="True"
                                   Margin="0,12,0,0" />
                        <TextBlock x:Name="PageSubtitle"
                                   Text="按程序管理手势动作。"
                                   IsTextSelectionEnabled="True"
                                   Opacity="0.72" />

                        <Grid x:Name="PageHost" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
