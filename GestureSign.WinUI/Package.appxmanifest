  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 desktop rescap">

  <Identity
    Name="TomClancy.GestureSignV2"
    Publisher="CN=A82713FB-4ABE-47C7-8184-01CF24575B7F"
    Version="18.2.3.0" />

  <Properties>
    <DisplayName>GestureSign V2</DisplayName>
    <PublisherDisplayName>风夏</PublisherDisplayName>
    <Logo>Assets\Store\StoreLogo.png</Logo>
