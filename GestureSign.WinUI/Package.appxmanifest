  <Applications>
    <Application
      Id="GestureSignV2"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="GestureSign V2"
        Description="GestureSign V2"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Store\Square150x150Logo.png"
        Square44x44Logo="Assets\Store\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="GestureSign V2"
          Square71x71Logo="Assets\Store\Square71x71Logo.png"
          Wide310x150Logo="Assets\Store\Wide310x150Logo.png"
          Square310x310Logo="Assets\Store\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\Store\SplashScreen.png" BackgroundColor="transparent" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension
          Category="windows.appExecutionAlias"
          Executable="Backend\GestureSign.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="GestureSignV2Daemon.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
